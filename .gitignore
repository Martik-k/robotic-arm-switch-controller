# 5. Model Weights & Checkpoints
# ------------------------------------------------------------------------------
# Ignore all binary weight checkpoints across all directories
*.pt
*.pth
*.pwf
*.onnx
*.engine
*.tflite
*.torchscript

# Specifically ignore root/downloaded base checkpoints
yolov8*.pt
yolo11*.pt
last.pt

# WHITELIST: Allow production lightweight model checkpoint (~6.2 MB) & metadata
!models/
!models/best.pt
!models/*.json

